---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, AUTHOR_NAME, AUTHOR_TITLE, AUTHOR_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = allPosts.slice(0, 4);

const formatDate = (date: Date) => {
	const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
	const month = months[date.getMonth()];
	const day = date.getDate();
	return `${month} ${day}`;
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:global(body) {
				min-height: 100vh;
			}

			main {
				width: 100%;
				max-width: 760px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.intro-section {
				padding: 2.5rem 0 2rem;
				display: flex;
				gap: 1.5rem;
				align-items: center;
			}

			.avatar-wrapper {
				flex-shrink: 0;
			}

			.intro-avatar {
				width: 96px;
				height: 96px;
				border-radius: 50%;
				object-fit: cover;
				border: 3px solid transparent;
				background: linear-gradient(135deg, var(--accent), #8b5cf6) padding-box,
							linear-gradient(135deg, var(--accent), #8b5cf6) border-box;
				box-shadow: 0 8px 30px rgba(59, 130, 246, 0.2);
			}

			.intro-content {
				flex: 1;
				min-width: 0;
			}

			.intro-title {
				font-size: 1.75rem;
				font-weight: 700;
				color: var(--text-primary);
				margin: 0 0 0.375rem 0;
				letter-spacing: -0.02em;
			}

			.intro-subtitle {
				font-size: 1rem;
				color: var(--accent);
				font-weight: 500;
				margin: 0 0 0.75rem 0;
			}

			.intro-description {
				font-size: 0.9rem;
				color: var(--text-secondary);
				line-height: 1.7;
				margin: 0;
			}

			.posts-section {
				margin-top: 1.5rem;
				padding-bottom: 1.5rem;
			}

			.section-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1rem;
				padding-top: 1.5rem;
				border-top: 1px solid var(--border-color);
			}

			.section-title {
				font-size: 1.125rem;
				font-weight: 700;
				color: var(--text-primary);
				margin: 0;
				position: relative;
				padding-left: calc(3px + 0.5rem);
			}

			.section-title::before {
				content: '';
				width: 3px;
				height: 1.125rem;
				background: linear-gradient(180deg, var(--accent), #8b5cf6);
				border-radius: 2px;
				position: absolute;
				left: 0;
				top: 50%;
				transform: translateY(-50%);
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding-left: calc(3px + 0.5rem);
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.section-link {
				font-size: 0.875rem;
				color: var(--accent);
				text-decoration: none;
				font-weight: 600;
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.5rem 1.25rem;
				border-radius: 0.5rem;
				background: rgba(59, 130, 246, 0.1);
				transition: all 0.2s ease;
			}
			.section-link:hover {
				background: var(--accent);
				color: white;
				transform: translateY(-2px);
				text-decoration: none;
			}



			.post-item {
                padding: 1.75rem 0;
                border-bottom: 1px solid var(--border-color);
            }
            .post-item:last-child { border-bottom: none; }
            .post-meta {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.5rem 1rem;
                margin-bottom: 0.5rem;
                font-size: 0.8rem;
                color: var(--text-secondary);
            }
            .post-tags { display: flex; flex-wrap: wrap; gap: 0.75rem; }
            .post-title {
                font-size: 1.25rem;
                font-weight: 600;
                line-height: 1.4;
                margin: 0 0 0.625rem;
                letter-spacing: -0.015em;
            }
            .post-link { color: var(--text-primary); }
            .post-link:hover { color: var(--accent); }
            .post-description {
                font-size: 0.95rem;
                line-height: 1.75;
                color: var(--text-secondary);
                margin: 0;
            }
            a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

			@media (max-width: 640px) {
				.intro-section {
					flex-direction: column;
					text-align: center;
					padding: 1.25rem 0 0.75rem;
				}

				.intro-avatar {
					width: 56px;
					height: 56px;
				}

				.intro-links {
					justify-content: center;
				}
			}

			html.dark .section-link {
				background: rgba(251, 146, 60, 0.15);
			}

			html.dark .section-link:hover {
				background: var(--accent);
				color: #0f172a;
			}

			html.dark .post-link:hover .post-title {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="intro-section">
				<!-- <div class="avatar-wrapper">
					<img
						class="intro-avatar"
						src="/avatar.svg"
						alt="Avatar"
					/>
				</div> -->
				<div class="intro-content">
					<h1 class="intro-title">{AUTHOR_NAME}</h1>
					<p class="intro-subtitle">{AUTHOR_TITLE}</p>
					<p class="intro-description">{AUTHOR_DESCRIPTION}</p>
				</div>
			</section>

			<section class="posts-section">
				<div class="section-header">
					<h2 class="section-title">Latest Posts</h2>
					<a href="/writing" class="section-link">View All →</a>
				</div>
				<ul class="post-list">
					{recentPosts.map((post) => (
						<li class="post-item">
                            <article>
                                <div class="post-meta">
                                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                                    {post.data.tags && post.data.tags.length > 0 && (
                                        <div class="post-tags">
                                            {post.data.tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
                                        </div>
                                    )}
                                </div>
                                <h3 class="post-title"><a href={`/writing/${post.id}/`} class="post-link">{post.data.title}</a></h3>
                                {post.data.description && <p class="post-description">{post.data.description}</p>}
                            </article>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>