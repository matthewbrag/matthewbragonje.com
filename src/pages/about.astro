---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { marked } from 'marked';

const aboutEntries = await getCollection('about');
const aboutContent = aboutEntries[0];
const renderedContent = aboutContent ? marked(aboutContent.body) : '';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About" description="Matthew Bragonje on building and investigating systems across machine learning, mathematics, software, and hardware." />
        <style>
            .about-section { max-width: 680px; margin: 0 auto; }
            .about-title {
                font-size: 2rem;
                font-weight: 700;
                color: var(--text-primary);
                margin: 0 0 1.75rem;
                letter-spacing: -0.02em;
            }
            .about-content { color: var(--text-secondary); font-size: 1rem; line-height: 1.85; }
            .about-content :global(p) { margin: 0 0 1.5rem; }
            .about-content :global(a) { text-decoration: underline; text-underline-offset: 4px; }
            .about-content :global(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
        </style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-section">
				{aboutContent && (
					<>
						{/* <img 
							class="about-avatar" 
							src="/avatar.svg"
							alt="Avatar"
						/> */}
						<h1 class="about-title">{aboutContent.data.name}</h1>
						{aboutContent.data.title && <p class="about-subtitle">{aboutContent.data.title}</p>}
						
						<article class="about-content" set:html={renderedContent} />
					</>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>